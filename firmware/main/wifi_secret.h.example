/* 复制为 wifi_secret.h 并填入真实值（wifi_secret.h 已 gitignore）。
 * BRIDGE_HOST    ：NVS 从未配置过 Bridge 地址时用哪个（默认激活）。
 * BRIDGE_SEED_HOSTS：开机并进设备地址簿（逗号分隔，幂等，不改当前地址），
 *                    用于预置公网服务器地址、免去设备软键盘输入。
 * BRIDGE_ACTIVATE_HOST：可选，非空则开机强制把当前地址切过去（部署新
 *                    Bridge 后免设备点按）；它会覆盖手动选择，用完删掉。
 *                    注意设备 HTTP 客户端只支持明文 http（无 TLS），且不发
 *                    Authorization —— 公网 Bridge 开 80/8081 明文端口，
 *                    不要设 BRIDGE_TOKEN。
 */
#define WIFI_SSID "your-2.4g-ssid"
#define WIFI_PASS "your-password"
#define BRIDGE_HOST "http://192.168.0.100:8081"
#define BRIDGE_SEED_HOSTS "http://192.168.0.100:8081,http://your-bridge.example.com:8081"
// #define BRIDGE_ACTIVATE_HOST "http://your-bridge.example.com"
