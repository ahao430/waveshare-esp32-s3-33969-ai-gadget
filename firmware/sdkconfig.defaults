# ESP32-S3R8：8MB 八线 PSRAM + 16MB Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 自定义分区表（含 OTA 双分区，PLAN §18 Phase 6 OTA）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL（esp_lvgl_port 由 BSP 拉入；缓冲尺寸 Phase 1 按真机调优）
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_32=y
# 图片解码缓存 256KB：esp_lv_decoder 的 PNG 内存解码无缓存时每个
# 绘制区域全量重解码（真机首帧卡死 30s+ TWDT，2026-11-15 实测）；
# 缓存放 PSRAM（adapter 的 LVGL 堆含 SPIRAM）
# UI 移植（共享源需要）：Montserrat 20/28/48 + GIF 解码（伴宠动画）
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_GIF=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_USE_QRCODE=y
# 内存水位（真机实测：UI+WiFi 后 internal 最大连续块 ~31KB）：
# 任务栈允许入 PSRAM（LVGL 任务栈走 PSRAM）。
# ⚠️ 勿开 CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP：lwIP pbuf 入 PSRAM 后
# Wi-Fi DMA 读不到（S3 限制）→ tcpip 线程结构体损坏 → Guru 崩溃重启
#（真机踩坑 2026-11-15）。内部水位靠显示分块 20 行（main.c
#  display_start_custom）适配，而非把 WiFi 缓冲搬去 PSRAM。
# pthread 默认栈 3KB→8KB：HTTP+cJSON fetch 链会溢出（真机 netconn 踩坏崩溃）
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
# UI 构建/首帧渲染在 240MHz 上可超 5s（GB2312 字体+全量页面），
# TWDT 放宽到 30s（真机 WDT 误杀 ui_init）
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# PSRAM 保持 80MHz：120MHz 对八线 PSRAM 为 IDF 实验特性（温漂风险），不开

CONFIG_LV_CACHE_DEF_SIZE=262144

# —— 渲染性能对齐官方 demo（examples/esp-idf/02_lvgl_demo_v9）——
# 我们此前是 -Og + 160MHz + 单绘制单元 + 33ms 刷新，比官方 demo
# （-O2 + 240MHz + 双单元 + 15ms）慢 3~5 倍，是"滑动卡死"的根因。
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OBJ_STYLE_CACHE=y

# LVGL 断言默认 while(1) 静默死机；开 ERROR 级日志让 LV_ASSERT_MSG 先打印
# 出表达式（真机 2026-11-15：Invalidate area is not allowed during rendering）
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_ERROR=y
CONFIG_LV_LOG_PRINTF=y

# 任务表诊断（hang 探针用 vTaskList 定位阻塞任务）
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# RLE 压缩字体解码：gen_cn_font.sh COMPRESS=1 生成的字体需要它
# （省 ~478KB flash；不开则中文渲染成空心方块）
CONFIG_LV_USE_FONT_COMPRESSED=y

# app_main 栈：UI 初始化路径会调 http_client（单请求 4KB 栈缓冲）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# 任务看门狗 panic 重启：显示管线楔死时自愈（HARDWARE §2.10）
CONFIG_ESP_TASK_WDT_PANIC=y

# 小智直连（ADR-014）TLS：mbedtls 分配走 PSRAM（官方 xiaozhi-esp32 的
# S3 配置同款）。曾误判 EXTERNAL 破坏加密——-0x008D 实为
# PSA_ERROR_INSUFFICIENT_MEMORY（内部 RAM 碎片化分配失败），2026-11-16。
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 小智直连（ADR-014）TLS 记录缓冲：默认 16KB in_buf 在页面期内部 RAM
# （largest ~12KB）永远分不下（mbedtls alloc(16717) failed → 伪装成
# -0x008D，2026-11-16 真机实证）。4096 足够：证书链会分片跨记录，
# 我们的消息都是小包（OTA JSON/WS hello/opus 帧）。
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096

# 内存策略（2026-11-17，官方 xiaozhi-esp32 S3 同款）：≤2KB 才优先内部
# RAM，LVGL 控件/样式/键盘等小分配全部落到 PSRAM——配网面板一次拉起
# 几百个小对象，16384 阈值下曾把内部 RAM 吃到 328B、largest_dma=0，
# 刷屏 Draw bitmap NO_MEM。2048 后内部 RAM 留给 Wi-Fi/DMA/驱动。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048

# FATFS API 用 UTF-8（2026-11-18 音乐曲库空根因）：默认 ANSI_OEM+437 码页
# 下，中文文件名（UTF-16 LFN）经 opendir 转码失败变 '?'，stat/fopen 反查
# LFN 不匹配 → ds_files_list 静默跳过 → 中文名 MP3 全部隐形。UTF-8 API 下
# readdir/stat/fopen 同编码 round-trip，中文名全链路通（显示也修复）。
CONFIG_FATFS_API_ENCODING_UTF_8=y
